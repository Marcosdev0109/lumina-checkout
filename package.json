{
  "name": "lumina-checkout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Checkout em React com carrinho fixo, validacao de cartao e fluxo de pagamento simulado.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "json-server --watch db.json --port 3001",
    "copiar-db": "node -e \"require('fs').copyFileSync('db.json','public/db.json')\"",
    "predev": "npm run copiar-db",
    "prebuild": "npm run copiar-db"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "json-server": "^0.17.4",
    "vite": "^5.4.8"
  }
}
